---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import figmaLogo from '../assets/logos/figma.svg';
import framerLogo from '../assets/logos/framer.svg';
// import shopifyLogo from '../assets/logos/shopify.svg';
import webflowLogo from '../assets/logos/webflow.svg';
import affinityLogo from '../assets/logos/affinitylogo.svg';

const tools = [
	{ name: 'Figma', logo: figmaLogo, tone: 'light' },
	{ name: 'Framer', logo: framerLogo, tone: 'dark' },
	// { name: 'Shopify', logo: shopifyLogo, tone: 'light' },
	{ name: 'Webflow', logo: webflowLogo, tone: 'light' },
	{ name: 'Affinity', logo: affinityLogo, tone: 'light' },
];
---

<Layout
	title="Resume | Astro Theme for UI/UX Designer Portfolios"
	description="Resume page example from the Maria Astro theme for UI/UX designer portfolios, showcasing experience, capabilities, and tools."
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<section class="hero">
				<p class="eyebrow">CV</p>
				<h1 class="display-title">10+ years shaping digital products through UX, UI, and systems thinking.</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						My work has focused on product clarity: helping teams bring structure to messy
						workflows, overloaded interfaces, and growing systems that need to scale without
						becoming harder to use.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Kort om mig</p>
				</div>
				<div class="story-block">
					<p><strong>Plats:</strong> Karlstad</p>
					<p><strong>Inriktning:</strong> UX/UI - Design, visuell kommunikation</p>
					<p><strong>Intressen:</strong> Användarupplevelser, designsystem och tillgänglighet</p>
					<p><strong>Kontakt:</strong> <a href="mailto:hello@maria.com">f.liideenn@gmail.com</a></p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Erfarenhet</p>
				</div>
				<div class="story-block">
					<p>
						<strong>Frilansande designer</strong><br />
						2025 - Pågående
					</p>
					<p>
						Samarbete med en annan frilansande designer i projekt för olika kunder, med fokus på UX/UI-design, webb och grafisk formgivning. Arbetena har bland annat omfattat research, wireframes, prototyper, framtagning av trycksaker och manualsättning. Genom projekten har jag fått kombinera användarvänlighet och visuell kommunikation för att skapa genomtänkta lösningar utifrån kundernas olika behov.
					</p>
					<p>
						<strong>Digital Design, LIA på Soleil</strong><br />
						Januari 2025 - April 2025
					</p>
					<p>
						Arbetat med UX/UI, digital design och webbutveckling i en professionell miljö. Fått erfarenhet av att utveckla digitala designlösningar både självständigt och tillsammans med teamet.
					</p>
					<p>
						<strong>Digital Design, LIA på Sunnenytt</strong><br />
						April 2024 - Juni 2024
					</p>
					<p>
						Arbetat med grafisk design, annonsproduktion och material för tryck och digital publicering. Även bidragit med innehåll och designrelaterade uppgifter för webbplatsen.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Utbildning</p>
				</div>
				<div class="story-block">
					<p>
						<strong>Skalbara designsystem och generativ design</strong><br />
						2025 - 2026, Brobygrafiska
					</p>
					<p>
						Praktisk utbildning med fokus på skalbara designsystem, systemtänk och komponentbaserad design. Arbetat med struktur och komponenter i Figma samt generativ AI för att effektivisera designprocesser och underhåll av designsystem.
					</p>
					<p>
						<strong>Digital Design</strong><br />
						2023 - 2025, Brobygrafiska
					</p>
					<p>
						Utbildning inom UX/UI, digital design och front-end för digitala medier med fokus på visuell kommunikation, färg, form och användarupplevelse. Arbetat genom hela designprocessen, från idé och koncept till färdig lösning.
					</p>
					<p>
						<strong>Samhällsvetenskap - Beteendevetenskap</strong><br />
						2018 - 2021, Stjerneskolan
					</p>
					<p>
						Studier med fokus på mänskligt beteende, kommunikation och gruppdynamik.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Kompetenser</p>
				</div>
				<div class="story-block">
					<p>
                        <strong>UX/UI och användarupplevelser:</strong> research, användarflöden, wireframes, prototyper och utformning av användarvänliga gränssnitt.
                    </p>
                    <p>
                        <strong>Visuell design:</strong> visuell kommunikation, grafisk design, färg, form och genomtänkta visuella uttryck för digitala medier.
                    </p>
					<p>
                        <strong>Designsystem:</strong> komponentbaserad design, struktur och arbete med skalbara designsystem i Figma.
                    </p>
					<p>
                        <strong>Webbutveckling:</strong> kunskap inom front-end med HTML, CSS, SCSS, JavaScript och Svelte, samt erfarenhet av CMS som Sitevision. Förståelse för hur design kan omsättas till fungerande och användarvänliga digitala lösningar.
                    </p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Verktyg</p>
				</div>
				<div class="tools-grid">
					{
						tools.map((tool) => (
							<div class="tool-card">
								<div class:list={['tool-mark', tool.tone === 'dark' && 'tool-mark-dark']} aria-hidden="true">
									<Image class="tool-logo" src={tool.logo} alt="" loading="lazy" />
								</div>
								<p class="tool-name">{tool.name}</p>
							</div>
						))
					}
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: 1fr;
		margin-top: 1.75rem;
	}

	.hero-text,
	.story-block p {
		font-size: 1.08rem;
		line-height: 1.7;
		margin: 0;
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-top: 1px solid var(--border);
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
	}

	.story-block strong {
		color: var(--foreground);
	}

	.tools-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 44rem;
	}

	.tool-card {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 1rem 1.05rem;
		border: 1px solid var(--border);
		border-radius: 1.15rem;
		background: var(--card);
	}

	.tool-mark {
		width: 3rem;
		height: 3rem;
		flex: 0 0 3rem;
		display: grid;
		place-items: center;
		border-radius: 0.9rem;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--muted) 90%, var(--card) 10%) 0%,
			color-mix(in srgb, var(--border) 55%, var(--card) 45%) 100%
		);
		border: 1px solid color-mix(in srgb, var(--border) 88%, var(--background) 12%);
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		color: var(--foreground);
	}

	.tool-mark-dark {
		background: #111111;
		border-color: #111111;
	}

	.tool-logo {
		width: 1.55rem;
		height: 1.55rem;
		display: block;
		object-fit: contain;
	}

	.tool-name {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	@media (max-width: 980px) {
		.hero-subgrid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.hero {
			padding: 4rem 0 3rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.hero-text,
		.story-block p {
			font-size: 1.05rem;
		}

		.tools-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
